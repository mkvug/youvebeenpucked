# Airtable Personal Access Token, scoped to read-only access on the base below.
# Create one at https://airtable.com/create/tokens
AIRTABLE_TOKEN=pat_xxxxxxxxxxxxxxxxx

# Airtable Base ID (starts with "app"), found in the base's API docs or its URL.
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Webhook URLs for the two Airtable Automations that handle "Keep it" /
# "Re-hide it" clicks on a puck page (see docs/airtable-found-webhook-setup.md).
# Each automation hardcodes its own target Status and just needs the record's
# ID, sent as url-encoded form body data (`puckId=...`). These are baked into
# client-side JS at build time (PUBLIC_ prefix), so they're not secrets —
# visible in page source.
PUBLIC_AIRTABLE_KEEP_WEBHOOK_URL=https://hooks.airtable.com/workflows/v1/genericWebhook/xxxxxxxxxxxxxxxxx
PUBLIC_AIRTABLE_REHIDE_WEBHOOK_URL=https://hooks.airtable.com/workflows/v1/genericWebhook/yyyyyyyyyyyyyyyyy
