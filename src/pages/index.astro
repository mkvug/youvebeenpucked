---
import Base from "../layouts/Base.astro";
import Badge from "../components/Badge.astro";
import Button from "../components/Button.astro";
import Container from "../components/Container.astro";
import PuckGrid from "../components/PuckGrid.astro";
import seriesData from "../data/series.json";
import pucksData from "../data/pucks.json";
import { toneFor } from "../lib/tones";
import { seriesDateLabel } from "../lib/seriesDate";
import type { Puck, Series } from "../lib/types";

const series = seriesData as Series[];
const pucks = pucksData as Puck[];

function pucksFor(slug: string) {
    return pucks.filter((p) => p.seriesSlug === slug);
}

const latest = series[0];
const latestPucks = latest ? pucksFor(latest.slug) : [];
const latestDate = latest ? seriesDateLabel(latestPucks) : null;
const previousSeries = series.slice(1);
---

<Base title="You've Been Pucked">
    {
        latest && (
            <section class="hero">
                <Container as="div" class="hero-inner">
                    <div class="hero-tag">
                        <Badge status="hidden">Latest series</Badge>
                        {latestDate && (
                            <span class="hero-date">{latestDate}</span>
                        )}
                    </div>
                    <h1>{latest.name}</h1>
                    {latest.notes && <p class="hero-tagline">{latest.notes}</p>}
                </Container>
            </section>
        )
    }

    {
        latest && latestPucks.length > 0 && (
            <section class="grid-section">
                <Container>
                    <PuckGrid
                        pucks={latestPucks}
                        seriesSlug={latest.slug}
                        tone={toneFor(0)}
                    />
                </Container>
            </section>
        )
    }

    {
        previousSeries.length > 0 && (
            <section class="previous-section">
                <Container>
                    <h2>Previous series</h2>
                    <div class="previous-grid">
                        {previousSeries.map((s, i) => {
                            const count = pucksFor(s.slug).length;
                            return (
                                <a class="series-card" href={`/${s.slug}/`}>
                                    <div class="series-name">{s.name}</div>
                                    <div class="series-meta">
                                        {count} {count === 1 ? "puck" : "pucks"}
                                    </div>
                                    <Button
                                        variant="outline"
                                        size="sm"
                                        as="span"
                                    >
                                        View series
                                    </Button>
                                </a>
                            );
                        })}
                    </div>
                </Container>
            </section>
        )
    }
</Base>

<style>
    .hero {
        background: var(--color-accent-coral);
    }
    .hero :global(.hero-inner) {
        padding-block: 72px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }
    .hero-tag {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
    }
    .hero-date {
        color: var(--white);
        font-size: var(--text-body-sm);
        font-weight: var(--weight-bold);
    }
    .hero h1 {
        font-size: var(--text-display-lg);
        color: var(--white);
        margin-bottom: 16px;
    }
    .hero-tagline {
        font-size: var(--text-body-lg);
        color: var(--white);
        line-height: 1.5;
        margin: 0;
        max-width: 460px;
    }

    .grid-section {
        padding-block: 56px;
    }

    .previous-section {
        padding-block: 40px 64px;
        border-top: 1px solid var(--color-border-default);
        background: var(--color-bg-surface-sunken);
    }
    .previous-section h2 {
        font-size: var(--text-display-sm);
        color: var(--color-text-primary);
        margin-bottom: 24px;
    }
    .previous-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
        margin-top: 56px;
    }
    .series-card {
        display: block;
        background: var(--color-bg-surface);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-md);
        padding: 20px;
        text-decoration: none;
        cursor: pointer;
    }
    .series-name {
        font-family: var(--font-display);
        font-weight: var(--weight-semibold);
        font-size: var(--text-display-sm);
        color: var(--color-text-primary);
        margin-bottom: 6px;
    }
    .series-meta {
        color: var(--color-text-muted);
        font-size: var(--text-body-sm);
        margin-bottom: 14px;
    }
</style>

<script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const cards = document.querySelectorAll<HTMLElement>(".series-card");
    const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    if (cards.length && !reduceMotion) {
        // Entrance pop uses scale/opacity so it doesn't fight the continuous
        // y-based scroll-lag drag set up below.
        gsap.set(cards, { opacity: 0, scale: 0.85 });

        ScrollTrigger.batch(".series-card", {
            start: "top 90%",
            once: true,
            onEnter: (batch) =>
                gsap.to(batch, {
                    opacity: 1,
                    scale: 1,
                    duration: 0.7,
                    ease: "back.out(1.7)",
                    stagger: 0.08,
                    overwrite: true,
                }),
        });

        // Cards lag behind the scroll and catch up with a springy delay,
        // as if being dragged along the page.
        cards.forEach((card) => {
            gsap.to(card, {
                y: -50,
                ease: "none",
                scrollTrigger: {
                    trigger: card,
                    start: "top bottom",
                    end: "bottom top",
                    scrub: 0.5,
                },
            });
        });
    }
</script>
