---
import Base from "../../layouts/Base.astro";
import Container from "../../components/Container.astro";
import Badge from "../../components/Badge.astro";
import Button from "../../components/Button.astro";
import Dialog from "../../components/Dialog.astro";
import PuckPhoto from "../../components/PuckPhoto.astro";
import seriesData from "../../data/series.json";
import pucksData from "../../data/pucks.json";
import { toneFor } from "../../lib/tones";
import { badgeStatus } from "../../lib/status";
import type { Puck, Series } from "../../lib/types";

export function getStaticPaths() {
    return (pucksData as Puck[]).map((puck) => ({
        params: { series: puck.seriesSlug, puck: puck.slug },
        props: {
            puck,
            series: (seriesData as Series[]).find(
                (series) => series.slug === puck.seriesSlug,
            ),
        },
    }));
}

interface Props {
    puck: Puck;
    series: Series | undefined;
}

const { puck, series } = Astro.props;

const allSeries = seriesData as Series[];
const allPucks = pucksData as Puck[];
const seriesIndex = series
    ? allSeries.findIndex((s) => s.slug === series.slug)
    : 0;
const tone = toneFor(seriesIndex);

const seriesPucks = series
    ? allPucks.filter((p) => p.seriesSlug === series.slug)
    : [puck];
const puckIndex = seriesPucks.findIndex((p) => p.id === puck.id);
const position = puckIndex >= 0 ? puckIndex + 1 : 1;

const status = badgeStatus(puck.status);

const STORY: Record<typeof status, string> = {
    found: "Someone spotted this one and marked it found. It might already be back out in the wild, or tucked in a new home.",
    keep: "This one found a forever home — it's off the hunt for good, and that's the whole point.",
    rehide: "Found once already, and set loose again for the next lucky neighbor to stumble on.",
    hidden: "Still out there somewhere, waiting to make someone's day.",
};
---

<Base title={`${puck.name} — ${series?.name ?? puck.seriesSlug}`}>
    <Container>
        <div class="puck-page">
            {
                series && (
                    <a
                        class="back-link fade"
                        style="animation-delay:0s"
                        href={`/${series.slug}/`}
                    >
                        &larr; Back to {series.name}
                    </a>
                )
            }

            <div class="photo-wrap">
                <div class="photo-float">
                    <div class="photo-clip">
                        <PuckPhoto
                            imageUrl={puck.imageUrl}
                            tone={tone}
                            size={220}
                            alt={puck.name}
                        />
                    </div>
                </div>
            </div>

            <div class="meta-row fade" style="animation-delay:.05s">
                <Badge status={status} />
                <span class="position"
                    >Puck {position} of {seriesPucks.length}</span
                >
            </div>

            <h1 class="fade" style="animation-delay:.1s">{puck.name}</h1>
            <p class="story fade" style="animation-delay:.2s">
                {STORY[status]}
            </p>

            <div class="cta-row fade" style="animation-delay:.25s">
                {
                    status === "hidden" && (
                        <Button variant="coral" size="lg" class="js-found-trigger">
                            I found this puck!
                        </Button>
                    )
                }
                {
                    series && (
                        <Button
                            variant="outline"
                            size="lg"
                            href={`/${series.slug}/`}
                        >
                            See the whole series
                        </Button>
                    )
                }
            </div>

            {
                status === "hidden" && (
                    <Dialog id="found-dialog">
                        <Fragment slot="title">Nice find!</Fragment>
                        <p>
                            Would you like to keep this one, or hide it again
                            for the next person to find?
                        </p>
                        <Fragment slot="actions">
                            <Button
                                variant="coral"
                                size="md"
                                class="js-keep-btn"
                            >
                                Keep it
                            </Button>
                            <Button
                                variant="outline"
                                size="md"
                                class="js-rehide-btn"
                            >
                                Re-hide it
                            </Button>
                        </Fragment>
                    </Dialog>
                )
            }
        </div>
    </Container>
</Base>

<script
    define:vars={{
        puckId: puck.id,
        keepWebhookUrl: import.meta.env.PUBLIC_AIRTABLE_KEEP_WEBHOOK_URL ?? "",
        rehideWebhookUrl:
            import.meta.env.PUBLIC_AIRTABLE_REHIDE_WEBHOOK_URL ?? "",
    }}
>
    const trigger = document.querySelector(".js-found-trigger");
    const dialog = document.querySelector("#found-dialog");
    const keepBtn = document.querySelector(".js-keep-btn");
    const rehideBtn = document.querySelector(".js-rehide-btn");
    const storageKey = `pucked:acted:${puckId}`;

    function markActed() {
        if (!trigger) return;
        trigger.disabled = true;
        trigger.textContent = "Thanks for the update!";
    }

    if (localStorage.getItem(storageKey)) markActed();

    trigger?.addEventListener("click", () => dialog?.showModal());

    // Separate webhooks per action — each Airtable Automation hardcodes its
    // own target Status, so the only input needed is which record to update.
    // This trigger type (Airtable Workflows' generic webhook) only ever reads
    // the request body — it doesn't expose URL query params as bindable
    // fields — so puckId has to travel as genuine url-encoded form data, not
    // JSON text, so Airtable can auto-parse it into a bindable field without
    // a script step.
    function submitAction(webhookUrl, label) {
        if (!webhookUrl) {
            console.warn(`${label} webhook URL is not set — skipping Airtable update.`);
            return;
        }
        // mode: "no-cors" is required since the endpoint doesn't support a
        // CORS preflight, which restricts Content-Type to a CORS-safelisted
        // value — Airtable accepts "application/x-www-form-urlencoded"
        // (rejects "text/plain"). Fire-and-forget: the response is opaque and
        // can't be read, so the UI update below is optimistic, not confirmed.
        fetch(webhookUrl, {
            method: "POST",
            mode: "no-cors",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: `puckId=${encodeURIComponent(puckId)}`,
        }).catch(() => {});
    }

    keepBtn?.addEventListener("click", () => {
        submitAction(keepWebhookUrl, "Keep");
        localStorage.setItem(storageKey, "Found");
        markActed();
    });
    rehideBtn?.addEventListener("click", () => {
        submitAction(rehideWebhookUrl, "Re-hide");
        localStorage.setItem(storageKey, "Hidden");
        markActed();
    });
</script>

<style>
    .puck-page {
        max-width: 560px;
        margin: 0 auto;
        padding-block: 56px 72px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .back-link {
        align-self: flex-start;
        color: var(--color-text-muted);
        font-family: var(--font-body);
        font-weight: var(--weight-bold);
        font-size: var(--text-body-sm);
        text-decoration: none;
        margin-bottom: 28px;
    }
    .back-link:hover {
        color: var(--color-text-secondary);
    }

    .photo-wrap {
        width: 220px;
        height: 220px;
        margin-bottom: 28px;
    }
    .photo-float {
        width: 100%;
        height: 100%;
        animation: pp-float 1.4s ease-in-out 1;
    }
    .photo-clip {
        position: relative;
        width: 220px;
        height: 220px;
        border-radius: 50%;
        overflow: hidden;
    }

    .meta-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
    }
    .position {
        font-size: var(--text-caption);
        font-weight: var(--weight-bold);
        letter-spacing: var(--tracking-eyebrow);
        text-transform: uppercase;
        color: var(--color-text-muted);
    }

    h1 {
        font-family: var(--font-display);
        font-weight: var(--weight-bold);
        font-size: var(--text-display-lg);
        color: var(--color-text-primary);
        margin: 0 0 8px;
        line-height: 1.05;
    }

    .story {
        font-size: var(--text-body);
        line-height: var(--leading-normal);
        color: var(--color-text-secondary);
        margin: 0 0 32px;
        max-width: 440px;
    }

    .cta-row {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        justify-content: center;
    }

    .fade {
        opacity: 0;
        animation: pp-fade-up 0.5s ease-out forwards;
    }

    @keyframes pp-float {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-10px);
        }
    }
    @keyframes pp-fade-up {
        from {
            opacity: 0;
            transform: translateY(14px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .photo-float,
        .fade {
            animation: none;
            opacity: 1;
            transform: none;
        }
    }
</style>
