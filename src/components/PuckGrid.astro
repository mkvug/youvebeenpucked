---
import Badge from "./Badge.astro";
import PuckPhoto from "./PuckPhoto.astro";
import type { Puck } from "../lib/types";

type Tone = "teal" | "coral" | "mustard" | "plum";
type BadgeStatus = "found" | "keep" | "rehide" | "hidden";

interface Props {
    pucks: Puck[];
    seriesSlug: string;
    tone: Tone;
}

const { pucks, seriesSlug, tone } = Astro.props;

function badgeStatus(status: string): BadgeStatus {
    if (status === "Found" || status === "Assumed Found") return "found";
    return "hidden";
}
---

<div class="ds-puck-grid">
    {
        pucks.map((puck) => (
            <a
                class="puck-tile"
                href={`/${seriesSlug}/${puck.slug}/`}
                data-status={badgeStatus(puck.status)}
            >
                <PuckPhoto
                    imageUrl={puck.imageUrl}
                    tone={tone}
                    size={256}
                    alt={puck.name}
                />
                <div class="puck-name">{puck.name}</div>
                <Badge status={badgeStatus(puck.status)} />
            </a>
        ))
    }
</div>

<style>
    .ds-puck-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 48px;
    }
    @media (min-width: 650px) {
        .ds-puck-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    @media (min-width: 960px) {
        .ds-puck-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    .puck-tile {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        border: none;
        background: none;
        padding: 0;
        font-family: var(--font-body);
        text-decoration: none;
    }
    .puck-tile[hidden] {
        display: none;
    }
    .puck-name {
        font-size: var(--text-caption);
        font-weight: var(--weight-bold);
        color: var(--color-text-primary);
        text-align: center;
        line-height: 1.2;
    }
</style>
