---
/** Centers page content to the site's max content width. Use inside full-width
 * sections (e.g. ones with a background color) to keep the color spanning
 * edge-to-edge while the content itself stays constrained. */
interface Props {
  as?: string;
  class?: string;
}

const { as: Tag = "div", class: className } = Astro.props;
---

<Tag class:list={["container", className]}>
  <slot />
</Tag>

<style>
  .container {
    width: 100%;
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding-inline: 48px;
  }

  @media (max-width: 640px) {
    .container {
      padding-inline: var(--page-gutter);
    }
  }
</style>
